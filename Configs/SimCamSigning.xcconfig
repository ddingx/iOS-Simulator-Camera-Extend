// Configs/SimCamSigning.xcconfig — sole source of truth for SimCamApp /
// SimCamExtension code-signing configuration.
//
// Why these values
// ----------------
//   * Apple Development / Personal Team can't be used: Apple refuses to
//     issue a Mac App Development provisioning profile with the System
//     Extension capability for Personal Teams (see docs/signing-and-tcc.md).
//   * Pure ad-hoc (`-`) breaks TCC across rebuilds (DR pins cdhash, every
//     rebuild => re-prompt for Camera/ScreenCapture).
//   * Self-signed CA gives a stable DR keyed off the certificate CN, so
//     TCC keeps its grants across rebuilds. Each developer generates the
//     cert locally with `make bootstrap-cert`; the private key never
//     enters the repo.
//
// If you want to switch to a real Apple Developer Program identity, copy
// this file to Configs/SimCamSigning.local.xcconfig and override the
// variables there — that filename is gitignored.

SIMCAM_CODE_SIGN_STYLE       = Manual
SIMCAM_CODE_SIGN_IDENTITY    = SimCam Local Dev
SIMCAM_DEVELOPMENT_TEAM      =
SIMCAM_CODE_SIGNING_REQUIRED = YES
SIMCAM_CODE_SIGNING_ALLOWED  = YES

// Allow a private, gitignored override at Configs/SimCamSigning.local.xcconfig
#include? "SimCamSigning.local.xcconfig"
